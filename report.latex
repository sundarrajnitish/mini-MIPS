\hline
ANDI \$t0, \$t1, 10 & 001100 & 01001 & 01000 & 0000000000001010 \\
\hline
SUBUI \$t0, \$t1, 5 & 011001 & 01001 & 01000 & 0000000000000101 \\

\hline
